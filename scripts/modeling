#!/usr/bin/env bash
# New tasks use v5; existing legacy tasks require the explicit historical route.
set -euo pipefail
modeling_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$modeling_repo_root"
if [[ "${1:-}" == "--legacy" ]]; then
  shift
  exec env PYTHONPATH="$modeling_repo_root:$modeling_repo_root/backend${PYTHONPATH:+:$PYTHONPATH}" \
    "$modeling_repo_root/backend/.venv/bin/python" -m modeling_team "$@"
fi
export UV_PROJECT_ENVIRONMENT="${ONTOWEAVE_V5_ENV:-$modeling_repo_root/workspaces/v5-codex-p0/.venv}"
exec uv run --locked --project "$modeling_repo_root/modeling_team/v5" \
  python -m ontoweave_modeling "$@"
