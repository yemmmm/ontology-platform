# Backend
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ontology_platform
POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology
DATABASE_URL=postgresql+psycopg://ontology:ontology@localhost:5434/ontology_platform?client_encoding=utf8

# Demo Agent / OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2

# Entity embeddings / Zhipu Embedding-3
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=45

# Semantic runtime POC / Oxigraph
OXIGRAPH_URL=http://localhost:7878
SEMANTIC_BASE_IRI=http://ontology-platform.local/semantic/
SEMANTIC_GRAPH_IRI_PREFIX=http://ontology-platform.local/semantic/graph/
SEMANTIC_QUERY_TIMEOUT_SECONDS=10
COMPETENCY_QUESTION_SPARQL_TIMEOUT_SECONDS=5
SEMANTIC_QUERY_RESULT_LIMIT=1000
SEMANTIC_SHACL_INFERENCE=none
SEMANTIC_REASONER_COMMAND=
SEMANTIC_REASONER_TIMEOUT_SECONDS=60
SEMANTIC_GRAPH_VISIBILITY_LABELS={}
BUILD_SESSION_LEASE_TTL_SECONDS=300
MODELING_BATCH_MAX_ITEMS=100
MODELING_BATCH_MAX_REQUEST_BYTES=1048576
MODELING_BATCH_MAX_INLINE_EVIDENCE=100
MODELING_BATCH_MAX_EVIDENCE_EXCERPT_CHARS=20000
MODELING_BATCH_RECOVERY_MAX_STEPS=3
MODELING_BATCH_EXECUTION_CLAIM_TTL_SECONDS=300

# Canonical RDF dataset migration controls
SEMANTIC_CANONICAL_STORE=legacy
SEMANTIC_PRODUCT_WRITE_MODE=legacy_only
SEMANTIC_READ_MODE=legacy
SEMANTIC_LEGACY_WRITE_BLOCKED=false
SEMANTIC_MIGRATION_BATCH_SIZE=200
SEMANTIC_MIGRATION_PARITY_REQUIRED=true
SEMANTIC_MIGRATION_PHASE2_MAPPING_VERSION=phase2-v1
SEMANTIC_MIGRATION_DEFAULT_SCOPE=ad_hoc
