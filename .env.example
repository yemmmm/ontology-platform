# Backend
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ontology_platform
POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology
DATABASE_URL=postgresql+psycopg://ontology:ontology@localhost:5432/ontology_platform?client_encoding=utf8

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontology-platform

# Demo Agent / OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2

# Entity embeddings / Zhipu Embedding-3
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=45

# Semantic runtime POC / Oxigraph
OXIGRAPH_URL=http://localhost:7878
SEMANTIC_BASE_IRI=http://ontology-platform.local/semantic/
SEMANTIC_GRAPH_IRI_PREFIX=http://ontology-platform.local/semantic/graph/
SEMANTIC_QUERY_TIMEOUT_SECONDS=10
SEMANTIC_QUERY_RESULT_LIMIT=1000
SEMANTIC_SHACL_INFERENCE=none
SEMANTIC_REASONER_COMMAND=
SEMANTIC_REASONER_TIMEOUT_SECONDS=60
SEMANTIC_NEO4J_PROJECTION_ENABLED=false
