[Unit]
Description=Ontology Platform backend and frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=SEMANTIC_CANONICAL_STORE=rdf
Environment=SEMANTIC_PRODUCT_WRITE_MODE=rdf_primary
Environment=SEMANTIC_READ_MODE=canonical
WorkingDirectory=/home/yangxiang/ontology-platform
ExecStart=/usr/bin/bash -lc 'exec ./scripts/start-local.sh'
Restart=on-failure
RestartSec=10
TimeoutStartSec=5min
TimeoutStopSec=30
KillMode=control-group
SuccessExitStatus=SIGTERM SIGINT

[Install]
WantedBy=default.target
