<mxfile host="Electron" modified="2026-07-22T00:00:00.000Z" version="26.0.0">
  <diagram id="modeling-agent-workflow" name="建模 Agent 流程">
    <mxGraphModel dx="1800" dy="1820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="建模 Agent 端到端流程" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;html=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="800" height="40" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="共享建模核心：业务理解先宽后深，模型按核心纵向切片与 Work Unit 分批写入" style="text;strokeColor=none;fillColor=none;fontSize=14;align=center;verticalAlign=middle;html=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="420" y="62" width="960" height="30" as="geometry" /></mxCell>

        <mxCell id="lane_user" value="用户" style="swimlane;horizontal=0;startSize=34;fillColor=#e1d5e7;swimlaneFillColor=#faf5ff;strokeColor=#9673a6;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="250" height="1660" as="geometry" /></mxCell>
        <mxCell id="lane_main" value="主建模 Agent" style="swimlane;horizontal=0;startSize=34;fillColor=#dae8fc;swimlaneFillColor=#eff6ff;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="500" height="1660" as="geometry" /></mxCell>
        <mxCell id="lane_sub" value="子 Agent / Repo-local 工具" style="swimlane;horizontal=0;startSize=34;fillColor=#d5e8d4;swimlaneFillColor=#f0fdf4;strokeColor=#82b366;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="450" height="1660" as="geometry" /></mxCell>
        <mxCell id="lane_platform" value="Ontology Platform" style="swimlane;horizontal=0;startSize=34;fillColor=#fff2cc;swimlaneFillColor=#fffbeb;strokeColor=#d6b656;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="510" height="1660" as="geometry" /></mxCell>

        <mxCell id="start" value="开始 / 恢复一次建模任务" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="135" y="55" width="230" height="58" as="geometry" /></mxCell>
        <mxCell id="recover" value="读取本地 ledger（如有）&#xa;请求 Project Build Context / Session / Modeling Context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_main"><mxGeometry x="75" y="145" width="350" height="80" as="geometry" /></mxCell>
        <mxCell id="platform_context" value="返回平台事实&#xa;当前 Ontology / workspace version&#xa;Batch / Artifact / Event / unresolved items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="lane_platform"><mxGeometry x="70" y="145" width="370" height="80" as="geometry" /></mxCell>

        <mxCell id="scan" value="全局扫描资料与业务范围&#xa;登记权威性、新鲜度、范围与非目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_main"><mxGeometry x="75" y="270" width="350" height="72" as="geometry" /></mxCell>
        <mxCell id="organize" value="业务整理子 Agent（独立上下文）&#xa;生成 Business Knowledge Pack&#xa;与 Modeling Coverage Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="lane_sub"><mxGeometry x="55" y="270" width="340" height="88" as="geometry" /></mxCell>
        <mxCell id="ask" value="只提出会改变模型语义、范围、优先级或验收的问题（每轮最多 3 个阻塞问题）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_main"><mxGeometry x="75" y="395" width="350" height="72" as="geometry" /></mxCell>
        <mxCell id="answer" value="确认业务摘要、高优先级能力问题、关键歧义与可接受缺口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="lane_user"><mxGeometry x="35" y="395" width="180" height="88" as="geometry" /></mxCell>
        <mxCell id="business_gate" value="业务 / 语义门禁通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="145" y="505" width="210" height="95" as="geometry" /></mxCell>

        <mxCell id="slice" value="选择能回答高优先级 CQ 的核心纵向切片&#xa;拆分 Work Unit，固定输入引用与验收合同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_main"><mxGeometry x="75" y="640" width="350" height="76" as="geometry" /></mxCell>
        <mxCell id="work_units" value="各 Work Unit 读取 Shared Modeling Directory&#xa;按 source / coverage / dependency 生成 result.json&#xa;大产物通过原子 handoff + Manifest 交接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="lane_sub"><mxGeometry x="55" y="625" width="340" height="106" as="geometry" /></mxCell>
        <mxCell id="merge" value="合并为 Ontology 唯一 candidate.json&#xa;检查重复标识、冲突术语、依赖和 candidate hash&#xa;按容量上限规划有序 Batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="75" y="755" width="350" height="94" as="geometry" /></mxCell>

        <mxCell id="dryrun" value="提交同一 Modeling Batch：mode=dry_run&#xa;不需要 Lease，不产生语义 / Evidence 副作用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="75" y="890" width="350" height="78" as="geometry" /></mxCell>
        <mxCell id="validate" value="编译命令 + 解析依赖 / Evidence&#xa;候选状态与 SHACL 确定性校验&#xa;返回 normalized delta + Findings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="lane_platform"><mxGeometry x="70" y="875" width="370" height="94" as="geometry" /></mxCell>
        <mxCell id="platform_gate" value="存在 blocking Finding？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="145" y="995" width="210" height="90" as="geometry" /></mxCell>

        <mxCell id="review" value="独立评审子 Agent&#xa;抽查原始资料 + Pack / Matrix + candidate + dry-run Findings&#xa;输出 PASS / REVISE / BLOCKED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="lane_sub"><mxGeometry x="55" y="1000" width="340" height="104" as="geometry" /></mxCell>
        <mxCell id="review_gate" value="评审 PASS？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="155" y="1115" width="190" height="86" as="geometry" /></mxCell>
        <mxCell id="rework" value="定向返工受影响 Work Unit&#xa;新候选哈希使旧评审 / Batch plan 失效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="lane_sub"><mxGeometry x="55" y="1140" width="340" height="72" as="geometry" /></mxCell>
        <mxCell id="blocked" value="补充资料 / 继续澄清&#xa;或明确停止本轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="lane_user"><mxGeometry x="35" y="1135" width="180" height="72" as="geometry" /></mxCell>

        <mxCell id="apply" value="主 Agent 获取 Ontology Lease&#xa;以新 idempotency key 提交 exact reviewed Batch&#xa;默认 apply_atomic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="75" y="1235" width="350" height="92" as="geometry" /></mxCell>
        <mxCell id="persist" value="校验 Session / Lease / workspace version&#xa;持久化 deterministic plan + write fence&#xa;写 PostgreSQL 与 RDF；不确定结果向前恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="lane_platform"><mxGeometry x="70" y="1215" width="370" height="108" as="geometry" /></mxCell>

        <mxCell id="verify" value="从平台当前态反向验收&#xa;Read Model · Context Query · scoped SPARQL&#xa;SHACL validation · Evidence / lineage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="75" y="1355" width="350" height="92" as="geometry" /></mxCell>
        <mxCell id="verify_platform" value="返回结构化语义上下文、查询结果、验证 Findings、证据与来源链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="lane_platform"><mxGeometry x="70" y="1355" width="370" height="78" as="geometry" /></mxCell>
        <mxCell id="complete" value="完成 Build Session / 交接" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="lane_main"><mxGeometry x="135" y="1575" width="230" height="58" as="geometry" /></mxCell>

        <mxCell id="profile_note" value="现状说明&#xa;Formal：当前 ontology-builder 使用平台 Artifact / Event / Checkpoint。&#xa;Local：R1.1-006 共享目录已实现，但统一 Profile/Adapter 仍属 R1.1-007 待实现。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;fontSize=12;" vertex="1" parent="lane_sub"><mxGeometry x="55" y="45" width="340" height="120" as="geometry" /></mxCell>
        <mxCell id="iteration_note" value="每批验证后：更新 Coverage。仍有未覆盖知识则选择下一批；CQ/召回失败则只返工受影响 Work Unit；全部通过后 complete Build Session。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="lane_sub"><mxGeometry x="55" y="1465" width="340" height="92" as="geometry" /></mxCell>

        <mxCell id="e_start_recover" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" source="start" target="recover" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_recover_context" value="读取" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="recover" target="platform_context" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_context_scan" value="确定下一步" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="platform_context" target="scan" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_scan_organize" value="版本化资料清单" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="scan" target="organize" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_organize_ask" value="歧义 / 缺口" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="organize" target="ask" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ask_answer" value="提问" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="ask" target="answer" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_answer_gate" value="可见回答" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="answer" target="business_gate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_gate_ask" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" source="business_gate" target="ask" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="615" /><mxPoint x="710" y="540" /></Array></mxGeometry></mxCell>
        <mxCell id="e_gate_slice" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" source="business_gate" target="slice" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_slice_units" value="run path + work_unit_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="slice" target="work_units" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_units_merge" value="result / Manifest / hash" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="work_units" target="merge" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_merge_dry" value="固定 client_batch_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="merge" target="dryrun" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_dry_validate" value="MCP / HTTP" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="dryrun" target="validate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_validate_gate" value="Findings" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="validate" target="platform_gate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_platform_rework" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" source="platform_gate" target="rework" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_platform_review" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" source="platform_gate" target="review" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_review_gate" value="评审结论" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="review" target="review_gate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_review_rework" value="REVISE" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" source="review_gate" target="rework" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_review_blocked" value="BLOCKED" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" source="review_gate" target="blocked" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_rework_merge" value="新候选" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" source="rework" target="merge" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="835" /></Array></mxGeometry></mxCell>
        <mxCell id="e_blocked_ask" value="补充信息" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;" edge="1" source="blocked" target="ask" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="510" /></Array></mxGeometry></mxCell>
        <mxCell id="e_review_apply" value="PASS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" source="review_gate" target="apply" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_apply_persist" value="Lease + exact reviewed content" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" source="apply" target="persist" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_persist_verify" value="applied / recovering" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="persist" target="verify" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_verify_platform" value="查询 / 验证" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" source="verify" target="verify_platform" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_verify_iteration" value="更新 Coverage / 决定下一批或完成" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;" edge="1" source="verify_platform" target="iteration_note" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_iteration_complete" value="全部验收通过" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" edge="1" source="iteration_note" target="complete" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_iteration_next" value="仍有未覆盖知识：下一批" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" edge="1" source="iteration_note" target="slice" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="1390" /><mxPoint x="1220" y="790" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
