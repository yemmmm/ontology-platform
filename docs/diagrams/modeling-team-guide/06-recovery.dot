digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.6", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=15, margin="0.20,0.14", color="#94a3b8", fontcolor="#172033", penwidth=1.1];
edge [fontname="Noto Sans CJK SC", fontsize=11, color="#64748b", fontcolor="#475569", arrowsize=0.75];
issue [label="发生阻断 / 用户要求阶段暂停\n记录首个失败层与实际 mutation state", fillcolor="#fee2e2", shape=box];
write [label="存在不确定或部分写入？", fillcolor="#ffedd5", shape=diamond];
reconcile [label="先关闭写门并对账\n覆盖恢复链全部 Ontology\nBatch / Attempt / Evidence / 回执\n包括检查点之后的写入", fillcolor="#fee2e2", shape=box];
alive [label="原 run / 角色线程仍可安全继续？", fillcolor="#ffedd5", shape=diamond];
live [label="同 run 恢复（006）\nreport_issue → pause\n宿主结构化 issue_resolution → resume\n修复当前失败步骤 / 供应商等待", fillcolor="#dbeafe", shape=box];
checkpoint [label="进程已退出：选择明确检查点（015）\n核对配置、材料、业务范围、写入尾部\n原写者 / Session / Lease 已安全收尾", fillcolor="#ffedd5", shape=box];
target [label="还需生产建模，还是仅继续验收？", fillcolor="#ffedd5", shape=diamond];
new [label="S2  生产接续\n新 run + 新线程 + 新 Session\n复用有效业务成果 / 审批\n已 applied 跳过，剩余计划重新 dry-run\n当前 Coordinator 重新翻译审阅", fillcolor="#dbeafe", shape=box];
only [label="S4  仅继续验收\n重验 production_handoff 与稳定状态\n只启动独立验收，不启动生产写角色\n保留原报告，生成新验收记录", fillcolor="#ede9fe", shape=box];
kinds [label="S1  五类检查点\nscenario_mapped：已有访谈 / 场景决定\ncq_frozen：已审核冻结 CQ\nsemantic_approved：获批语义成果\nmaterialization_progress：确定物化进度\nproduction_handoff：稳定生产交接", fillcolor="#ccfbf1", shape=box];
budget [label="授权与保留\n同活线程继续：沿原授权\n新生产线程：消耗 fresh semantic start\n只保存 / 查看 / 仅验收：不消耗建模 start\n历史失败、写入证据、曝光记录均保留", fillcolor="#fef3c7", shape=box];
issue -> write [label="", style=solid];
write -> reconcile [label="是", style=solid];
write -> alive [label="否", style=solid];
reconcile -> alive [label="已充分确定结果；否则保持阻塞", style=solid];
alive -> live [label="是", style=solid];
alive -> checkpoint [label="否，且有可用检查点", style=solid];
checkpoint -> target [label="", style=solid];
target -> new [label="剩余生产", style=solid];
target -> only [label="生产已交接", style=solid];
kinds -> checkpoint [label="按明确 ID 选取", style=dashed];
live -> budget [label="", style=solid];
new -> budget [label="", style=solid];
only -> budget [label="", style=solid];
}