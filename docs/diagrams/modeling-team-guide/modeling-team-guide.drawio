          <mxGeometry as="geometry" x="61.0" y="314.0" width="254.0" height="88.0" />
        </mxCell>
        <mxCell id="alive" parent="1" vertex="1" value="原 run / 角色线程仍可安全继续？" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=15;fillColor=#ffedd5;strokeColor=#94a3b8;fontColor=#172033;spacing=8;">
          <mxGeometry as="geometry" x="30.0" y="482.0" width="496.0" height="74.0" />
        </mxCell>
        <mxCell id="live" parent="1" vertex="1" value="同 run 恢复（006）&#10;report_issue → pause&#10;宿主结构化 issue_resolution → resume&#10;修复当前失败步骤 / 供应商等待" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=15;fillColor=#dbeafe;strokeColor=#94a3b8;fontColor=#172033;spacing=8;">
          <mxGeometry as="geometry" x="130.0" y="729.0" width="296.0" height="88.0" />
        </mxCell>
        <mxCell id="checkpoint" parent="1" vertex="1" value="进程已退出：选择明确检查点（015）&#10;核对配置、材料、业务范围、写入尾部&#10;原写者 / Session / Lease 已安全收尾" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=15;fillColor=#ffedd5;strokeColor=#94a3b8;fontColor=#172033;spacing=8;">
          <mxGeometry as="geometry" x="507.0" y="636.0" width="284.0" height="71.0" />
        </mxCell>
        <mxCell id="target" parent="1" vertex="1" value="还需生产建模，还是仅继续验收？" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=15;fillColor=#ffedd5;strokeColor=#94a3b8;fontColor=#172033;spacing=8;">
          <mxGeometry as="geometry" x="395.0" y="839.0" width="508.0" height="74.0" />
        </mxCell>
        <mxCell id="new" parent="1" vertex="1" value="S2  生产接续&#10;新 run + 新线程 + 新 Session&#10;复用有效业务成果 / 审批&#10;已 applied 跳过，剩余计划重新 dry-run&#10;当前 Coordinator 重新翻译审阅" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=15;fillColor=#dbeafe;strokeColor=#94a3b8;fontColor=#172033;spacing=8;">
          <mxGeometry as="geometry" x="319.0" y="969.0" width="292.0" height="105.0" />
        </mxCell>
        <mxCell id="only" parent="1" vertex="1" value="S4  仅继续验收&#10;重验 production_handoff 与稳定状态&#10;只启动独立验收，不启动生产写角色&#10;保留原报告，生成新验收记录" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Noto Sans CJK SC;fontSize=15;fillColor=#ede9fe;strokeColor=#94a3b8;fontColor=#172033;spacing=8;">
