@prefix impact: <https://example.org/ontology/dify-workflow-impact-m1#> .
@prefix ex: <https://example.org/ontology/dify-workflow-impact-m1/fixture/published#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:c a impact:Workflow, owl:NamedIndividual ; rdfs:label "Content Quality Scoring Workflow" ; impact:hasVersion ex:c-v1, ex:c-v2 ; impact:activeLatestVersion ex:c-v2 ; impact:completeness "complete" ; impact:sourceKind "synthetic-fixture" .
ex:c-v1 a impact:WorkflowVersion, owl:NamedIndividual ; rdfs:label "Content Quality Scoring Workflow v1" ; impact:versionOf ex:c ; impact:publicationState "superseded" ; impact:completeness "complete" .
ex:c-v2 a impact:PublishedWorkflowVersion, impact:WorkflowVersion, owl:NamedIndividual ; rdfs:label "Content Quality Scoring Workflow v2" ; impact:versionOf ex:c ; impact:publicationState "latest" ; impact:completeness "complete" .
ex:c-content a impact:Variable, owl:NamedIndividual ; rdfs:label "C input: content" ; impact:declaredByVersion ex:c-v2 ; impact:variableName "content" ; impact:dataType "string" ; impact:variableRole "input" ; impact:completeness "complete" .
ex:c-quality-score a impact:Variable, owl:NamedIndividual ; rdfs:label "C deleted output: quality_score" ; impact:declaredByVersion ex:c-v1 ; impact:variableName "quality_score" ; impact:dataType "number" ; impact:variableRole "output" ; impact:completeness "complete" .
ex:published-delete-quality a impact:ChangeSet, owl:NamedIndividual ; rdfs:label "Publish C v2 deleting quality_score" ; impact:previousVersion ex:c-v1 ; impact:changeAppliesToVersion ex:c-v2 ; impact:deletesVariable ex:c-quality-score ; impact:publicationState "latest" ; impact:completeness "complete" ; impact:sourceKind "synthetic-fixture" .

ex:b a impact:Workflow, owl:NamedIndividual ; rdfs:label "Content Generation Workflow" ; impact:hasVersion ex:b-v1 ; impact:activeLatestVersion ex:b-v1 ; impact:completeness "complete" ; impact:sourceKind "synthetic-fixture" .
ex:b-v1 a impact:PublishedWorkflowVersion, impact:WorkflowVersion, owl:NamedIndividual ; rdfs:label "Content Generation Workflow v1" ; impact:versionOf ex:b ; impact:publicationState "latest" ; impact:completeness "complete" ; impact:hasInvocation ex:b-c-invocation ; impact:hasUse ex:b-if-use, ex:b-output-use .
ex:c-tool a impact:WorkflowTool, owl:NamedIndividual ; rdfs:label "Content Quality Scoring Workflow Tool" ; impact:toolTargetsVersion ex:c-v2 ; impact:completeness "complete" .
ex:b-c-invocation a impact:ToolInvocation, owl:NamedIndividual ; rdfs:label "B invokes C" ; impact:invokesTool ex:c-tool ; impact:callSiteId "b-v1.node.tool-c" ; impact:callSiteLocation "Content Generation Workflow v1 / Tool C node" ; impact:bindingAtInvocation ex:b-content-binding, ex:b-quality-binding ; impact:completeness "complete" .
ex:b-content-source a impact:Variable, owl:NamedIndividual ; rdfs:label "B input: content" ; impact:declaredByVersion ex:b-v1 ; impact:variableName "content" ; impact:dataType "string" ; impact:variableRole "input" ; impact:completeness "complete" .
ex:b-content-binding a impact:VariableBinding, owl:NamedIndividual ; rdfs:label "Bind B.content to C.content" ; impact:bindingSource ex:b-content-source ; impact:bindingTarget ex:c-content ; impact:completeness "complete" .
ex:b-quality-score a impact:Variable, owl:NamedIndividual ; rdfs:label "B local: quality_score" ; impact:declaredByVersion ex:b-v1 ; impact:variableName "quality_score" ; impact:dataType "number" ; impact:variableRole "local" ; impact:derivedFromVariable ex:c-quality-score ; impact:completeness "complete" .
ex:b-quality-binding a impact:VariableBinding, owl:NamedIndividual ; rdfs:label "Bind C.quality_score to B.quality_score" ; impact:bindingSource ex:c-quality-score ; impact:bindingTarget ex:b-quality-score ; impact:completeness "complete" .
ex:b-if-use a impact:VariableUse, owl:NamedIndividual ; rdfs:label "B IF/ELSE quality gate" ; impact:usesVariable ex:b-quality-score ; impact:producesVariable ex:b-approved-content ; impact:useKind "if-else-condition" ; impact:completeness "complete" .
ex:b-approved-content a impact:Variable, owl:NamedIndividual ; rdfs:label "B output: approved_content" ; impact:declaredByVersion ex:b-v1 ; impact:variableName "approved_content" ; impact:dataType "string" ; impact:variableRole "output" ; impact:completeness "complete" .
ex:b-output-use a impact:VariableUse, owl:NamedIndividual ; rdfs:label "B Output exposes approved_content" ; impact:usesVariable ex:b-approved-content ; impact:useKind "output" ; impact:completeness "complete" .

ex:a a impact:Workflow, owl:NamedIndividual ; rdfs:label "Campaign Publication Workflow" ; impact:hasVersion ex:a-v1 ; impact:activeLatestVersion ex:a-v1 ; impact:completeness "complete" ; impact:sourceKind "synthetic-fixture" .
ex:a-v1 a impact:PublishedWorkflowVersion, impact:WorkflowVersion, owl:NamedIndividual ; rdfs:label "Campaign Publication Workflow v1" ; impact:versionOf ex:a ; impact:publicationState "latest" ; impact:completeness "complete" ; impact:hasInvocation ex:a-b-invocation ; impact:hasUse ex:a-publish-use .
ex:b-tool a impact:WorkflowTool, owl:NamedIndividual ; rdfs:label "Content Generation Workflow Tool" ; impact:toolTargetsVersion ex:b-v1 ; impact:completeness "complete" .
ex:a-b-invocation a impact:ToolInvocation, owl:NamedIndividual ; rdfs:label "A invokes B" ; impact:invokesTool ex:b-tool ; impact:callSiteId "a-v1.node.tool-b" ; impact:callSiteLocation "Campaign Publication Workflow v1 / Tool B node" ; impact:bindingAtInvocation ex:a-approved-binding ; impact:completeness "complete" .
ex:a-publish-content a impact:Variable, owl:NamedIndividual ; rdfs:label "A local: publish_content" ; impact:declaredByVersion ex:a-v1 ; impact:variableName "publish_content" ; impact:dataType "string" ; impact:variableRole "local" ; impact:derivedFromVariable ex:b-approved-content ; impact:completeness "complete" .
ex:a-approved-binding a impact:VariableBinding, owl:NamedIndividual ; rdfs:label "Bind B.approved_content to A.publish_content" ; impact:bindingSource ex:b-approved-content ; impact:bindingTarget ex:a-publish-content ; impact:completeness "complete" .
ex:a-publish-use a impact:VariableUse, owl:NamedIndividual ; rdfs:label "A publication preparation consumes publish_content" ; impact:usesVariable ex:a-publish-content ; impact:useKind "publication-preparation" ; impact:completeness "complete" .
