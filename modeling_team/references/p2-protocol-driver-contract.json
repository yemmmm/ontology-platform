{
  "schema_version": "p2-protocol-driver/v1",
  "command": "uv",
  "argv": [
    "run",
    "--project",
    "backend",
    "python",
    "-m",
    "modeling_team.p2_protocol_driver",
    "--contract",
    "modeling_team/references/p2-protocol-driver-contract.json"
  ],
  "required_stages": [
    "driver_started",
    "protocol_roster_started",
    "candidate_delivered",
    "candidate_receipt",
    "query_completed",
    "fallback_required",
    "verifier_completed",
    "broker_terminal_guard",
    "protocol_report_accepted",
    "protocol_runtime_cleanup",
    "scope_cleanup_first_stage",
    "scope_deleted",
    "scope_cleanup_second_stage",
    "driver_stopped"
  ],
  "forbidden_evidence": [
    "teamrunner",
    "modeling_team run",
    "start_ledger",
    "semantic_start",
    "modeling terminal",
    "terminal-result-handoff",
    "ack_terminal_handoff",
    "all-agent settlement",
    "runner/terminal-result"
  ],
  "candidate_sender_id": "p2-synthetic-modeling",
  "protocol_agent_id": "protocol",
  "scope_mode": "create",
  "protocol_tools": [
    "check_platform_health",
    "get_project_build_context",
    "get_ontology_workspace_context",
    "create_build_session",
    "get_build_session",
    "save_build_checkpoint",
    "complete_build_session",
    "cancel_build_session",
    "acquire_ontology_lease",
    "renew_ontology_lease",
    "release_ontology_lease",
    "submit_modeling_batch",
    "get_modeling_batch",
    "list_session_modeling_batches",
    "list_ontology_modeling_batches",
    "get_modeling_context",
    "get_ontology_read_model",
    "query_semantic_context",
    "run_semantic_validation",
    "run_semantic_reasoning",
    "get_ontology_lineage",
    "inspect_semantic_statement_provenance"
  ],
  "runtime_contract": {
    "adapter": "CodexRuntimeAdapter.start_roster",
    "broker": "TeamTransportBroker",
    "stdio": true,
    "private_bwrap": true,
    "app_server": true,
    "native_mcp": [
      "team_transport",
      "ontology_platform",
      "protocol_mechanics"
    ]
  },
  "max_runtime_seconds": 900,
  "evidence_mode": "append_only_run_local",
  "cleanup_policy": {
    "scope_mode": "create",
    "max_owned_ephemeral_scopes": 1,
    "delete_requires_first_stage": true,
    "admin_revoke_in_finally": true,
    "no_direct_db_delete": true,
    "no_new_deletion_key": true
  }
}
