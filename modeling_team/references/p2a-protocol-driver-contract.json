{
  "argv": [
    "run",
    "--project",
    "backend",
    "python",
    "-m",
    "modeling_team.p2a_protocol_driver",
    "--contract",
    "modeling_team/references/p2a-protocol-driver-contract.json"
  ],
  "candidate_sender_id": "p2a-synthetic-modeling",
  "cleanup_policy": {
    "admin_revoke_in_finally": true,
    "delete_requires_first_stage": true,
    "max_owned_ephemeral_scopes": 1,
    "no_direct_db_delete": true,
    "no_new_deletion_key": true,
    "scope_mode": "create"
  },
  "command": "uv",
  "evidence_mode": "append_only_run_local",
  "forbidden_evidence": [
    "teamrunner",
    "start_ledger",
    "semantic_start",
    "terminal-result-handoff",
    "ack_terminal_handoff",
    "p2a-pass"
  ],
  "max_runtime_seconds": 900,
  "protocol_agent_id": "protocol",
  "protocol_tools": [
    "check_platform_health",
    "get_project_build_context",
    "get_ontology_workspace_context",
    "create_build_session",
    "get_build_session",
    "save_build_checkpoint",
    "complete_build_session",
    "cancel_build_session",
    "acquire_ontology_lease",
    "renew_ontology_lease",
    "release_ontology_lease",
    "submit_modeling_batch",
    "get_modeling_batch",
    "list_session_modeling_batches",
    "list_ontology_modeling_batches",
    "get_modeling_context",
    "get_ontology_read_model",
    "query_semantic_context",
    "run_semantic_validation",
    "run_semantic_reasoning",
    "get_ontology_lineage",
    "inspect_semantic_statement_provenance"
  ],
  "required_stages": [
    "driver_started",
    "matrix_validated",
    "protocol_roster_started",
    "candidate_delivered",
    "candidate_receipt",
    "dry_run_observed",
    "apply_observed",
    "postapply_evidence_observed",
    "retrieval_observed",
    "native_verifier_completed",
    "protocol_report_accepted",
    "protocol_runtime_cleanup",
    "scope_cleanup_first_stage",
    "scope_deleted",
    "scope_cleanup_second_stage",
    "driver_stopped"
  ],
  "runtime_contract": {
    "adapter": "P2ACodexRuntimeAdapter.start_roster",
    "app_server": true,
    "bounded_correction": {
      "adapter_method": "send_message",
      "credential_expiry": "explicit_null_when_unsupported",
      "lease_policy": "exact_identity_and_original_expiry_no_renew",
      "max_continuations": 1,
      "max_native_verifier_calls": 3,
      "same_agent_thread_run": true
    },
    "broker": "TeamTransportBroker",
    "idle_flush_grace_seconds": 1.0,
    "native_mcp": [
      "team_transport",
      "ontology_platform",
      "protocol_mechanics",
      "p2a_protocol_overlay"
    ],
    "protocol_retrieval_mcp": {
      "args": [
        "/opt/protocol-retrieval-mcp.py"
      ],
      "command": "/usr/bin/python3",
      "runtime_context_path": "/opt/mechanics-contract.json",
      "runtime_run_id_env": "PROTOCOL_RUNTIME_RUN_ID",
      "server": "protocol_mechanics",
      "tools": [
        "build_candidate_receipt",
        "verify_scoped_retrieval_fallback",
        "write_candidate_item_evidence_map"
      ]
    },
    "private_bwrap": true,
    "p2a_overlay": {
      "args": [
        "/opt/p2a_protocol_overlay_mcp.py"
      ],
      "command": "/usr/bin/python3",
      "contract_path": "modeling_team/references/p2a-overlay-contract.json",
      "server": "p2a_protocol_overlay",
      "task_id": "p2a-protocol-production",
      "tools": [
        "build_p2a_batch_plan",
        "verify_p2a_dry_run_evidence_projection"
      ]
    },
    "proof_v2_asset": {
      "mode": "0600",
      "mount_path": "/opt/proof_v2.py",
      "parent_mode": "0700",
      "sha256": "b053f01cfd389f3541fa89702134db899770b5b5276c57f3048131176868c593",
      "source_path": "modeling_team/proof_v2.py",
      "staged_path": "runtime-assets/protocol/proof_v2.py"
    },
    "stdio": true
  },
  "schema_version": "p2a-protocol-driver/v1",
  "scope_mode": "create"
}
